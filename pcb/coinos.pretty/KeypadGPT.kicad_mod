  (fp_line (start -26.2 35.15) (end -26.2 -35.15) (layer "F.CrtYd") (width 0.05))

  (pad "" np_thru_hole circle (at -22.7 -31.65) (size 3.4 3.4) (drill 3.2) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at  22.7 -31.65) (size 3.4 3.4) (drill 3.2) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -22.7  31.65) (size 3.4 3.4) (drill 3.2) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at  22.7  31.65) (size 3.4 3.4) (drill 3.2) (layers "*.Cu" "*.Mask"))

  (pad "1" thru_hole circle (at -7.62 -37.2) (size 1.9 1.9) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -5.08 -37.2) (size 1.9 1.9) (drill 1.0) (layers "*.Cu" "*.Mask"))
